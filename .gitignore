# Python environments
.venv/
venv/
env/

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Jupyter and development notebooks (not used by the deployed app)
.ipynb_checkpoints/
acv/notebook/
shm/notebook/

# Local coding-agent configuration (not part of the app or submission)
.agents/
.pi/
AGENTS.md
SKILLS.md
.gitattributes

# Editors and operating systems
.DS_Store
.vscode/
.idea/
*.swp

# Local Streamlit secrets
.streamlit/secrets.toml

# Raw competition data and example submissions must not be committed/deployed
PS3/02_Datasets/
PS3/04_Example_Submission/

# Logs and temporary files
*.log
*.tmp
*.temp

# Generated feature caches, validation reports, and browser artifacts
# None are loaded by the Streamlit app; final deliverables live under delivery/<team>/.
cache/
outputs/
catboost_info/

# Test, evaluation, and supporting write-up sources are development-only
# (already tracked files remain tracked; these rules affect only new untracked files).
tests/
door/evaluate.py
door/metrics.py
shm/evaluate.py
shm/metrics.py
acv/README.md
shm/writeup.md

# Local prediction staging and duplicate root archive
# The submission copy is delivery/<team>/predictions.zip.
predictions/
/predictions.zip

# Write-up source copies and document-generation helpers
# The submission copy is delivery/<team>/Optional_Items/write_up.pdf.
writeups/
docs/ACV_solution_writeup.pdf
scripts/combine_writeups.py
scripts/render_acv_writeup_pdf.py

# Local demo recordings; only the final team-folder copy is submitted
/demo_video.*
outputs/**/*.mp4
outputs/**/*.mov
